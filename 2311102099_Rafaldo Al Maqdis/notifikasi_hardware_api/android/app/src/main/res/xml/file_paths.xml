<?xml version="1.0" encoding="utf-8"?>
<!--
  file_paths.xml
  Konfigurasi path yang diizinkan oleh FileProvider.
  Dibutuhkan oleh image_picker agar bisa menyimpan dan berbagi file sementara.
-->
<paths>
    <!-- Path ke direktori cache eksternal (tempat foto sementara disimpan) -->
    <external-cache-path name="image_capture" path="." />

    <!-- Path ke file eksternal umum -->
    <external-files-path name="image_picker" path="." />

    <!-- Path cache internal -->
    <cache-path name="cache" path="." />

    <!-- Path file internal -->
    <files-path name="files" path="." />
</paths>
